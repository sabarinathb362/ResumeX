{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "resumex-api",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-X",
        "faulthandler",
        "-m",
        "uvicorn",
        "backend.main:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "resumex-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "resumex-web-8001",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5180"
      ],
      "port": 5180,
      "env": {
        "RESUMEX_API": "http://localhost:8001"
      }
    }
  ]
}